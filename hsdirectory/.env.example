# HSDS API base URL
# Local development: point at the local FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8080

# Production only: direct internal API URL for SSR (avoids loopback through Nginx)
# Set this in the systemd service environment, NOT in .env files.
# INTERNAL_API_URL=http://127.0.0.1:8300

# Optional: override the map basemap style URL (defaults to OpenFreeMap bright)
# NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
